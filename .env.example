# Parable Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ───────────────────────────────────────────────
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-256-bit-random-key

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://parable:parable_dev@localhost:5432/parable
DATABASE_POOL_SIZE=20

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── API ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ─── Web ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# ─── LLM / Communication Layer ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# ─── AWS (Production) ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=parable-data-dev

# ─── Monitoring ────────────────────────────────────────────────
DATADOG_API_KEY=
SENTRY_DSN=

# ─── Security ──────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Stripe (Payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PERSONAL_PRO=price_...
STRIPE_PRICE_TEAM=price_...
